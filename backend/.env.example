# --- PostgreSQL -------------------------------------------------------------
# Sync psycopg3 driver. Matches the docker-compose service below.
CHECKPOINTER_POOL_SIZE=5
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/csam

# --- Gemini -----------------------------------------------------------------
# Backend-only. Never put this in a NEXT_PUBLIC_* variable. Without it /chat
# still works, but every reply is the fallback and llm_success is false.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1024
# MINIMAL | LOW | MEDIUM | HIGH
GEMINI_THINKING_LEVEL=minimal

# --- ChromaDB (Phase 5) -----------------------------------------------------
CHROMA_PATH=./data/chroma

# --- Memory retrieval -------------------------------------------------------
MEMORY_TOP_K=5
# Relevance floor (cosine similarity). Calibrated, not guessed: a directly
# relevant memory scores ~0.53-0.71, an indirect one ~0.36, noise ~0.09.
MEMORY_SIMILARITY_THRESHOLD=0.30
# "Is this the same fact?" — a much higher bar than "is this relevant?".
# A reworded duplicate scores ~0.88; a genuinely different fact ~0.58.
MEMORY_DEDUP_THRESHOLD=0.85

# --- RAG retrieval ----------------------------------------------------------
KNOWLEDGE_TOP_K=5
# Relevance floor for a documentation chunk. A real question's best chunk
# scores 0.55-0.65; a passing remark peaks at 0.21; off-topic is below 0.01.
KNOWLEDGE_SIMILARITY_THRESHOLD=0.35
KNOWLEDGE_CHUNK_SIZE=700
KNOWLEDGE_CHUNK_OVERLAP=80

# --- Conversation history ---------------------------------------------------
HISTORY_MESSAGE_LIMIT=20
MAX_MESSAGE_CHARS=4000
# Earlier customer turns joined to the current one when searching. A follow-up
# question carries no subject of its own; alone it retrieves nothing.
RETRIEVAL_CONTEXT_TURNS=2

# --- CORS -------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000

# --- Authentication ---------------------------------------------------------
# Signing key for JWTs. Must be at least 32 bytes (RFC 7518) — the app refuses
# to start otherwise. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every issued token, signing everyone out.
JWT_SECRET=
JWT_ALGORITHM=HS256
# One week. A support chat is not a bank.
JWT_EXPIRE_MINUTES=10080
PASSWORD_MIN_LENGTH=8
AUTH_COOKIE_NAME=csam_token
# MUST be true wherever the site is served over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
